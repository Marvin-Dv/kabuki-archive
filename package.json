{
  "name": "kabuki-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Kabuki Archive — banco de dados e wiki não oficial de Honkai: Star Rail",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/build-index.ts && nuxt dev",
    "build": "tsx scripts/build-index.ts && nuxt build",
    "generate": "tsx scripts/build-index.ts && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:index": "tsx scripts/build-index.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "~8.5.6",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.9.0",
    "nuxt": "~3.15.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
    "pnpm": {
    "overrides": {
      "unstorage": "~1.15.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
