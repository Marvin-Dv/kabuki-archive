        [0.1812, 0.2437, 0.5625, 0.4062, 0.4062, 0.65],
        [0.1875, 0.2625, 0.575, 0.4375, 0.4375, 0.65],
        [0.1938, 0.2812, 0.5875, 0.4688, 0.4688, 0.65],
        [0.2, 0.3, 0.6, 0.5, 0.5, 0.65],
        [0.205, 0.315, 0.61, 0.525, 0.525, 0.65],
